{
  "name": "quickgab",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/libre-franklin": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.118.0",
    "expo": "~58.0.23",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^1.68.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "jpeg-js": "^0.4.4",
    "supabase": "3.0.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lottie": "node scripts/make-lottie.mjs",
    "timing:report": "node scripts/scan-timing-report.mjs",
    "tokens": "node scripts/sync-tokens.mjs",
    "ingredients": "npx -y tsx sites/sugardepth/scripts/sync-ingredients.ts",
    "test": "npm run test:unit && npm run test:backend",
    "test:unit": "npx -y tsx --test tests/unit/*.test.ts supabase/functions/_shared/*.test.ts src/lib/*.test.ts",
    "test:backend": "node scripts/test-backend.mjs",
    "test:db": "node scripts/test-backend.mjs --db",
    "test:functions": "node scripts/test-backend.mjs --functions",
    "eval": "npx -y tsx tests/eval/run-eval.mjs",
    "local:functions": "npx supabase functions serve --env-file supabase/functions/.env.local",
    "local:user": "node scripts/local-supabase.mjs user",
    "local:app-env": "node scripts/local-supabase.mjs app-env",
    "test:rules": "npx -y tsx --test supabase/functions/_shared/*.test.ts src/lib/combine.test.ts src/lib/display.test.ts src/lib/glossary.test.ts src/lib/photo.test.ts src/lib/sharpness.test.ts src/lib/autoCapture.test.ts src/lib/scanStream.test.ts src/lib/scan.test.ts",
    "build:web": "expo export --platform web --output-dir dist-web && sh scripts/fix-web-assets.sh dist-web"
  },
  "private": true
}
